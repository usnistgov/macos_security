"\n"
"|Buongiorno\n"
"\n"
"|79\n"
"\n"
"|Dito\n"
"\n"
"|20, 21\n"
"\n"
"|Protocollo di trasferimento file (FTP)\n"
"\n"
"|80\n"
"\n"
"|HTTP\n"
"\n"
"|icmp\n"
"\n"
"|ping\n"
"\n"
"|143\n"
"\n"
"|Protocollo di accesso ai messaggi Internet (IMAP)\n"
"\n"
"|993\n"
"\n"
"|Protocollo di accesso ai messaggi Internet su SSL (IMAPS)\n"
"\n"
"|3689\n"
"\n"
"|Condivisione di musica\n"
"\n"
"|5353\n"
"\n"
"|mDNSResponder\n"
"\n"
"|2049\n"
"\n"
"|File System di rete (NFS)\n"
"\n"
