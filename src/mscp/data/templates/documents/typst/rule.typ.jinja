#table(
  columns: (15%, 85%),
  stroke: 0.75pt + border-col,
  align: (left + top, left + top),
  inset: 6pt,
  [*ID*], [{{ rule.rule_id | typst_escape }}{% if rule.severity is not none %} \ *{% trans %}Severity{% endtrans %}:* {{ rule.severity | typst_escape }}{% endif %}],
  [*{% trans %}References{% endtrans %}*], [
    #table(
      columns: (22%, 78%),
      stroke: none,
      inset: 3pt,
      align: (left + top, left + top),
      {% if rule.references.nist.nist_800_53r5 is not none %}[*800-53r5*], [{{ rule.references.nist.nist_800_53r5 | group_ulify }}],{% endif %}
      {% if ("800-171" in baseline.title | upper or show_all_tags) and rule.references.nist.nist_800_171r3 is not none %}[*800-171r3*], [{{ rule.references.nist.nist_800_171r3 | render_rules }}],{% endif %}
      {% if ("STIG" in baseline.title | upper or show_all_tags) and rule.references.disa.disa_stig is not none %}[*DISA STIG(s)*], [{{ rule.references.disa.disa_stig | render_rules }}],{% endif %}
      {% if ("STIG" in baseline.title | upper or show_all_tags) and rule.references.disa.sfr is not none %}[*SFR*], [{{ rule.references.disa.sfr | render_rules }}],{% endif %}
      {% if ("CIS" in baseline.title | upper or show_all_tags) and rule.references.cis.benchmark is not none %}[*CIS Benchmark*], [{{ rule.references.cis.benchmark | render_rules }}],{% endif %}
      {% if ("CIS" in baseline.title | upper or show_all_tags) and rule.references.cis.controls_v8 is not none %}[*CIS Controls V8*], [{{ rule.references.cis.controls_v8 | render_rules }}],{% endif %}
      {% if ("INDIGO" in baseline.title | upper or show_all_tags) and rule.references.bsi.indigo is not none %}[*indigo*], [{{ rule.references.bsi.indigo | render_rules }}],{% endif %}
      {% if ("NLMAPGOV" in baseline.title | upper or show_all_tags) and rule.references.bzk.bio is not none %}[*BZK: BIO*], [{{ rule.references.bzk.bio | render_rules }}],{% endif %}
      {% if ("CMMC" in baseline.title | upper or show_all_tags) and rule.references.disa.cmmc is not none %}[*CMMC*], [{{ rule.references.disa.cmmc | render_rules }}],{% endif %}
      {% if ("HICP_LP" in baseline.title | upper or show_all_tags) and rule.references.hhs.hicp is not none %}[*HICP*], [{{ rule.references.hhs.hicp | render_rules }}],{% endif %}
      {% if rule.references.nist.cce is not none %}[*CCE*], [{{ rule.references.nist.cce | render_rules }}],{% endif %}
      {% if "references" in rule.customized and rule.references.custom_refs is not none %}[*Custom References*], [{{ rule.references.custom_refs.references | render_references }}],{% endif %}
      {% if show_all_tags and rule.tags is not none %}[*TAGS*], [{{ rule.tags | render_rules }}],{% endif %}
    )
  ],
)

